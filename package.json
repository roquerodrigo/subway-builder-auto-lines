{
  "name": "subway-builder-auto-lines",
  "version": "1.3.0",
  "description": "Subway Builder mod that extends a line along its corridor or creates a new line from unserved stations, with demand-based trains.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install-mod": "npm run build && node scripts/install-mod.mjs",
    "debug": "node scripts/debug.mjs",
    "inspect": "node scripts/cdp-eval.mjs",
    "play": "npm run install-mod && npm run debug",
    "package": "npm run build && node scripts/package-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Rodrigo Roque",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.2"
  }
}
